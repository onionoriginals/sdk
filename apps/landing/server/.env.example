# Turnkey parent-org API credentials (server-only)
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_ORGANIZATION_ID=

# JWT signing secret for the session cookie. At least 32 characters — the boot
# contract (server/config.ts) reports a shorter one by name rather than letting
# every login fail later with a generic message.
JWT_SECRET=

# Server port (default 8787)
PORT=8787

# How many proxies sit in front of this service (Railway: 1; no proxy: 0).
# Rate limiting reads it to pick the client identity out of X-Forwarded-For:
# unset, every client collapses into one site-wide bucket. Required on a deploy.
TRUSTED_PROXY_HOPS=1

# Opt in to the STRICT boot contract: a deployed instance with a missing or
# malformed required value refuses to start instead of warning and degrading.
# Warn-only by default — read one clean boot log against the real environment
# first, then set this. Rollback is unsetting it (no code redeploy).
# CONFIG_STRICT=1

# ─── Real Bitcoin inscription (Track B) — all optional ───────────────────────
# When these are set, the demo's Inscribe step does a REAL Bitcoin inscription.
# Absent → inscribe stays on the mock provider.
#
# Which network the SERVER speaks: mainnet | testnet4 (default testnet4).
# The QuickNodeProvider verifies the endpoint's chain against this on first RPC
# and fails loudly on a mismatch.
BTC_NETWORK=testnet4

# QuickNode endpoint WITH the Ordinals & Runes add-on, on the SAME network as
# BTC_NETWORK (the add-on's sat index is mainnet-only — no testnet4 coverage).
# Required for the ordinals-aware sat lookup (getFirstSatOfOutput) + fee +
# broadcast. Check: `bun run apps/landing/scripts/check-quicknode-ordinals.ts`.
QUICKNODE_ENDPOINT=

# ── testnet4 only: the faucet ────────────────────────────────────────────────
# On MAINNET there is no faucet (creator-pays): users deposit BTC to their own
# Turnkey-derived bc1q address, and these BTC_FAUCET_* vars are ignored.
#
# The faucet: a funded testnet4 P2WPKH (tb1q…) address that funds each user's
# inscription. Pick ONE signing method:
#   (a) Raw key (simplest): the address's WIF (testnet, starts with 'c'/'9').
BTC_FAUCET_WIF=
#   (b) Turnkey-org wallet: the wallet id holding the address (no raw key).
# BTC_FAUCET_WALLET_ID=
# The tb1q… address itself (with a raw WIF this is derived + verified from it).
BTC_FAUCET_ADDRESS=
# Sats sent to the user per inscription (default 20000).
BTC_FAUCET_SATS=20000
# Optional override for the mempool.space REST base used for address/UTXO reads
# (defaults: mainnet https://mempool.space/api, testnet4
# https://mempool.space/testnet4/api).
# MEMPOOL_API=
# MEMPOOL_TESTNET4_API=https://mempool.space/testnet4/api

# Where durable per-user data lives (Originals + in-flight inscriptions). On a
# deploy this MUST be a mounted volume: the boot contract checks the path
# against the platform's injected mount path (RAILWAY_VOLUME_MOUNT_PATH /
# VOLUME_MOUNT_PATH) and the mount table, because a writable-but-ephemeral path
# is deleted by the next redeploy — and it holds the only copies of signed
# reveal transactions.
# ORIGINALS_DATA_DIR=/data

# ─── Browser build-time flag (set BEFORE `bun run build`) ────────────────────
# Flips the demo engine from the mock provider to a real network. MUST match
# BTC_NETWORK — the browser checks the two against each other via
# GET /api/btc/network and disables inscribing on a skew, rather than showing a
# deposit address this deploy cannot spend from. Vite bakes this at build time,
# so you MUST rebuild the SPA after setting it. (Legacy VITE_BTC_TESTNET=1
# still means testnet4.) The server also checks this pair AT BOOT, in both
# directions — including the silent one, where this is unset against a fully
# configured real BTC_NETWORK and the deploy serves a mock site to everyone.
VITE_BTC_NETWORK=testnet4
