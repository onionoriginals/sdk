    "kind": "code",
    "paths": [
      ".rev/prepare-pr.mjs",
      ".rev-tool/src/coverage.js",
      ".rev-tool/src/gate.js",
      ".rev-tool/scripts/change.js",
      ".rev-tool/src/corpus.js",
      ".rev/release-pr.mjs",
      ".rev/release-task.json",
      ".rev/release-contract.json"
    ]
  },
  {
    "id": "expectations",
    "kind": "test",
    "paths": [
      ".rev/pr-coverage.test.mjs",
      ".rev-tool/test/coverage.test.js",
      ".rev-tool/test/action.test.js",
      ".rev-tool/test/change.test.js",
      ".rev/release-pr.test.mjs"
    ]
  },
  {
    "id": "observations",
    "kind": "behavior",
    "paths": [
      ".rev/pr-observations.txt"
    ]
  },
  {
    "id": "operator",
    "kind": "code",
    "paths": [
      ".rev/PR-COVERAGE.md",
      ".rev/pr-contract.json",
      ".rev/pr-sources.json",
      ".rev/pr-task.json"
    ]
