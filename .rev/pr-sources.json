[
  {
    "id": "workflow",
    "kind": "code",
    "paths": [
      ".github/workflows/ci.yml",
      ".github/workflows/rev-local-review.yml",
      ".rev/local-review.json"
    ]
  },
  {
    "id": "collector",
    "kind": "code",
    "paths": [
      ".rev/prepare-pr.mjs",
      ".rev-tool/src/coverage.js",
      ".rev-tool/src/gate.js",
      ".rev-tool/scripts/change.js",
      ".rev-tool/src/corpus.js"
    ]
  },
  {
    "id": "expectations",
    "kind": "test",
    "paths": [
      ".rev/pr-coverage.test.mjs",
      ".rev-tool/test/coverage.test.js",
      ".rev-tool/test/action.test.js",
      ".rev-tool/test/change.test.js"
    ]
  },
  {
    "id": "observations",
    "kind": "behavior",
    "paths": [
      ".rev/pr-observations.txt"
    ]
  },
  {
    "id": "operator",
    "kind": "code",
    "paths": [
      ".rev/PR-COVERAGE.md",
      ".rev/pr-contract.json",
      ".rev/pr-sources.json",
      ".rev/pr-task.json",
      ".rev/LOCAL_REVIEW.md"
    ]
  },
  {
    "id": "evaluator-validation",
    "kind": "report",
    "paths": [
      ".rev/evaluator-validation.json"
    ]
  },
  {
    "id": "local-verifier-source",
    "kind": "code",
    "paths": [
      ".rev-local-tool/scripts/local-review-gate.js",
      ".rev-local-tool/src/local/github.js",
      ".rev-local-tool/src/local/protocol.js",
      ".rev-local-tool/scripts/github-review.js"
    ]
  }
]
