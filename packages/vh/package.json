{
  "name": "@originals/vh",
  "version": "0.1.0",
  "private": true,
  "description": "Verifiable History for the Originals Protocol: strict JSON/JCS, eddsa-jcs-2022 and bip340-jcs-2025, a VH-Log engine and did:vh; browser-safe",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./json": {
      "types": "./dist/json/index.d.ts",
      "import": "./dist/json/index.js",
      "default": "./dist/json/index.js"
    },
    "./crypto": {
      "types": "./dist/crypto/index.d.ts",
      "import": "./dist/crypto/index.js",
      "default": "./dist/crypto/index.js"
    },
    "./log": {
      "types": "./dist/log/index.d.ts",
      "import": "./dist/log/index.js",
      "default": "./dist/log/index.js"
    },
    "./didvh": {
      "types": "./dist/didvh/index.d.ts",
      "import": "./dist/didvh/index.js",
      "default": "./dist/didvh/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p . && tsc -p tsconfig.interop.json",
    "test": "bun test tests/",
    "test:coverage": "bun test tests/ --coverage",
    "test:ci": "bash -o pipefail -c 'bun test tests/ --coverage 2>&1 | bun run ../../scripts/check-coverage.ts'",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "interop:driver": "bun interop/driver.ts"
  },
  "keywords": [
    "originals",
    "verifiable-history",
    "vh-log",
    "did:vh",
    "provenance"
  ],
  "author": "Aviary Tech",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/onionoriginals/sdk"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.0.1",
    "@scure/base": "^2.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^26.0.1",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "bun-types": "^1.3.1",
    "eslint": "^10.6.0",
    "prettier": "^3.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=20.10.0"
  }
}
