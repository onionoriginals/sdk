{
  "name": "@originals/host",
  "version": "0.2.0",
  "description": "Protocol-side server for Originals hosting: did:webvh hosted layout, durable per-user Originals store and routes, shared-host saves, the JSON-LD context route, and Bitcoin inscription tracking, anchoring and reconciliation. Bun runtime.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test tests/",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "originals",
    "did:webvh",
    "hosting",
    "server",
    "bitcoin"
  ],
  "author": "Aviary Tech",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/onionoriginals/sdk"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "@originals/sdk": "^5.1.0",
    "@originals/vh": "^0.3.0",
    "@scure/base": "^2.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^26.0.1",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "bun-types": "^1.3.1",
    "eslint": "^10.6.0",
    "prettier": "^3.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
