{
  "name": "@originals/sdk",
  "version": "2.1.0",
  "description": "TypeScript SDK for the Originals Protocol - creating, discovering, and transferring digital assets with cryptographically verifiable provenance",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "originals-cel": "./dist/cel/cli/index.js"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./cel": {
      "types": "./dist/cel/index.d.ts",
      "import": "./dist/cel/index.js",
      "default": "./dist/cel/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "default": "./dist/types/index.js"
    }
  },
  "scripts": {
    "build": "tsc && tsc-alias",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test tests/integration && bun test tests/unit && bun test tests/security && bun test tests/stress",
    "test:coverage": "bun test tests/integration tests/unit --coverage",
    "check-coverage": "bun run ../../scripts/check-coverage.ts",
    "test:ci": "bash -o pipefail -c 'bun test tests/integration tests/unit --coverage 2>&1 | bun run ../../scripts/check-coverage.ts'",
    "test:security": "bun test tests/security",
    "test:stress": "bun test tests/stress",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "originals",
    "did",
    "verifiable-credentials",
    "bitcoin",
    "ordinals",
    "digital-assets",
    "provenance",
    "decentralized-identity"
  ],
  "author": "Aviary Tech",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/onionoriginals/sdk"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {
    "@aviarytech/did-peer": "^1.1.2",
    "@digitalbazaar/bbs-signatures": "^3.1.0",
    "@noble/curves": "^2.2.0",
    "@originals/cel": "^0.1.0",
    "@noble/ed25519": "^3.1.0",
    "@noble/hashes": "^2.0.1",
    "@noble/secp256k1": "^3.1.0",
    "@scure/base": "^2.2.0",
    "@scure/btc-signer": "^2.2.0",
    "b58": "^4.0.3",
    "bitcoinjs-lib": "^6.1.0",
    "didwebvh-ts": "^2.8.0",
    "fflate": "^0.8.3",
    "jsonld": "^8.3.3",
    "micro-ordinals": "^0.2.2",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^26.0.1",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "bun-types": "^1.3.1",
    "eslint": "^10.6.0",
    "prettier": "^3.0.0",
    "tsc-alias": "^1.8.16",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=20.10.0"
  }
}
